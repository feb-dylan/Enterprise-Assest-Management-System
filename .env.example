# Copy this file to ".env" (same folder) and fill in your values.
# ".env" is git-ignored, so your passwords never get committed.
# The backend reads it automatically on startup.

# ---------- Required ----------
# Your MySQL password (the user is "root" unless you change DB_USERNAME)
DB_PASSWORD=change-me
# Any random text, at least 32 characters
JWT_SECRET=change-me-to-a-long-random-string-of-32-plus-characters

# ---------- Optional: database location ----------
# DB_URL=jdbc:mysql://localhost:3306/eams_db?createDatabaseIfNotExist=true
# DB_USERNAME=root

# ---------- Optional: AI via OpenRouter (free) ----------
# Key from https://openrouter.ai/keys
OPENROUTER_API_KEY=
# A model id from https://openrouter.ai/models (free ones end with ":free").
# It must support "tools". For damage photos it must also accept images,
# otherwise set a separate AI_VISION_MODEL that does.
AI_MODEL=
AI_VISION_MODEL=

# ---------- Optional: demo data (run once with true, then set back to false) ----------
SEED_DEMO_DATA=false

# ---------- Optional: email notifications ----------
MAIL_ENABLED=false
# MAIL_USERNAME=you@gmail.com
# MAIL_PASSWORD=your-gmail-app-password
# MAIL_FROM=you@gmail.com
